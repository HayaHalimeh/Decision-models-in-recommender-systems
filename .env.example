# Copy this file to .env and fill in the keys of the models you run.

# Jev (hosted decision model)
JEV_API_KEY=
# OpenAI: OpenAI Decisions (decision model) and GPT-6 Luna (LLM, thinking on and off)
OPENAI_API_KEY=
# OpenRouter: Microsoft-Decision-1 (decision model)
OPENROUTER_API_KEY=
# Qwen3.8-27B is too large to run locally on most machines: run it on your own GPU server,
# or, if your institution provides it, use its key here
Qwen27_API_KEY=
# Hugging Face token: local models: Qwen3.5-4B / 9B / 4B-Base, Clef-flash, Perplexity Decider flash, Kev-4B, PLMs
HF_TOKEN=
