results/*/progress*.jsonl
# notebooks: local working notebooks, not part of the experiments
notebooks/
# Yelp terms (no redistribution): the Yelp candidate files store each user's full history (LOCKED_SETTINGS 9)
data/full/candidates/yelp*
# validation-user candidates: only used for trial runs, not for any reported result
data/full/candidates/*.val.*
# scripts that are only used locally (checks, one-off migration, server setup and serving, run helpers)
scripts/check_candidates.py
scripts/check_complete.py
scripts/retie_results.py
scripts/make_longhist.py
scripts/run_pipeline.sh
