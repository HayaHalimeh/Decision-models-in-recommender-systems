scripts/crosscheck_amazon.py
src/dm4recsys/data/crosscheck.py
results/*/amazon_crosscheck.json
# validation-user trial runs (not results)
runs/**/val/
# not published: result rows (Yelp RQ2/RQ3 rows store user histories) and the working docs
runs/
